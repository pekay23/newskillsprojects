# Raymond Gray IFM Platform - Environment Variables
# Copy this file to .env and fill in your actual values.
# Do NOT commit .env to source control!

# Neon PostgreSQL
# Get this from your Neon console
NEON_URL=postgresql://user:password@project-name.neon.tech/dbname?sslmode=require

# Supabase Auth
# Get this from Supabase Project Settings -> API
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret

# Redis (Local Docker)
REDIS_URL=redis://localhost:6379

# MinIO (Local Docker)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Docker Registry (For CI/CD)
DOCKER_REGISTRY=localhost:5000
